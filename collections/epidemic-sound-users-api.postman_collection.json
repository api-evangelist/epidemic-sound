        {
          "id": "1d0b15fa-9f77-428c-aac5-418be1167311",
          "name": "List users' liked tracks",
          "request": {
            "name": "List users' liked tracks",
            "description": {
              "content": "The liked tracks endpoint lets you list the liked tracks of a connected user.\nUsers can add new tracks to their list on epidemicsound.com or via the Epidemic Sound app, giving them a smooth cross-device experience.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "users",
                "me",
                "liked",
                "tracks"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "offset",
                  "value": "<integer>",
                  "description": "Offset for the pagination. For this endpoint the number of results is fixed at 25, so the offset needs to be evenly divisible by 25."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "oauth2",
              "oauth2": [
                {
                  "key": "accessTokenUrl",
                  "value": "https://login.epidemicsound.com/auth/realms/accounts/protocol/openid-connect/token"
                },
                {
                  "key": "authUrl",
                  "value": "https://login.epidemicsound.com/auth/realms/accounts/protocol/openid-connect/auth"
                },
                {
                  "key": "grant_type",
                  "value": "authorization_code"
                }
              ]
            }
          },
