        {
          "id": "5926f29c-fdcc-43ba-80b8-c6f46427269c",
          "name": "Get track versions job status",
          "request": {
            "name": "Get track versions job status",
            "description": {
              "content": "This endpoint allows you to check the status of a track versions job.\nWhen the job is complete, it will return the URLs to the generated tracks.\n\n**Waveform Data:**\n- By default, waveform data is excluded to reduce payload size\n- Use `expand=waveform` to include waveform data in the response",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v0",
                "tracks",
                "versions",
                ":jobId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "description": {
                    "content": "Include additional data in response. Use 'waveform' to include waveform data.",
                    "type": "text/plain"
                  },
                  "key": "expand",
                  "value": ""
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "",
                  "key": "jobId",
                  "description": "(Required) The ID of the job to check"
